# --- Database ---------------------------------------------------------------
# Hosted PostgreSQL. This app is deployed (Vercel) and shared by two people, so
# the database can no longer be a local SQLite file: a serverless filesystem is
# ephemeral and per-instance, which would serve a different empty DB per cold
# start. Any managed Postgres works — Vercel Postgres / Neon / Supabase.
#
# Use the POOLED connection string here (serverless opens many short-lived
# connections). Run migrations with the DIRECT (non-pooled) string:
#   DATABASE_URL="<direct url>" npm run db:deploy
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# --- Auth (required) --------------------------------------------------------
# HMAC key that signs the session cookie. Auth FAILS CLOSED without it: every
# request is rejected rather than waved through, so a misconfigured deploy looks
# broken instead of looking open. Generate one:
#   openssl rand -base64 48
# Rotating this value invalidates every existing session (the global sign-out).
SESSION_SECRET=""

# There is NO signup route. Create the trusted users manually, once:
#   npm run db:seed -- <name> "<passphrase>" "<Display Name>"
# Passphrases must be at least 12 characters (the login endpoint is public).

# --- Gemini -----------------------------------------------------------------
# Provide your Gemini key before running synthesis / Q&A / grading.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY="REPLACE_WITH_YOUR_GEMINI_API_KEY"
# Optional overrides.
# GEMINI_MODEL="gemini-3.6-flash"
# GEMINI_EMBED_MODEL="text-embedding-004"

# --- Hard AI budget cap -----------------------------------------------------
# Checked BEFORE every paid Gemini call (src/lib/aiusage.ts); a breach returns
# HTTP 429 instead of spending. Unset = the safe defaults below. An explicit 0
# means "block everything", never "unlimited".
# AI_DAILY_COST_LIMIT_USD="1.00"
# AI_MONTHLY_COST_LIMIT_USD="20.00"
# Timezone the daily/monthly windows reset in (the server runs in UTC on Vercel,
# the student reads the reset time in WIB).
# AI_BUDGET_TIMEZONE="Asia/Jakarta"

# --- Real iOS web-push notifications (Soso reminds you) ----------------------
# Generate a VAPID key pair once with:  npx web-push generate-vapid-keys
# The PUBLIC key must be exposed to the browser (NEXT_PUBLIC_ prefix) so the
# client can subscribe; the PRIVATE key and SUBJECT stay server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
# Shared secret that the Vercel cron jobs send to /api/push/send and
# /api/cron/daily-reminder. Those two routes are exempt from the session gate
# (cron carries no cookie), so in a real deployment this MUST be set — it is the
# only thing guarding them. Leave blank for local dev (no guard).
CRON_SECRET=""
